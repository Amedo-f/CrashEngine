<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Amedo 2026-09-29 -->
  <PropertyGroup>
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CrashEngine.Core\CrashEngine.Core.csproj" />
    <ProjectReference Include="..\CrashEngine.Renderer\CrashEngine.Renderer.csproj" />
    <ProjectReference Include="..\CrashEngine.Assets\CrashEngine.Assets.csproj" />
    <ProjectReference Include="..\CrashEngine.Stealth\CrashEngine.Stealth.csproj" />
    <ProjectReference Include="..\CrashEngine.Importer\CrashEngine.Importer.csproj" />
    <ProjectReference Include="..\CrashEngine.Runtime\CrashEngine.Runtime.csproj" />
    <ProjectReference Include="..\CrashEngine.Install\CrashEngine.Install.csproj" />
    <!-- Amedo 2026-11-18 -->
    <ProjectReference Include="..\CrashEngine.ScriptGen\CrashEngine.ScriptGen.csproj" />
    <!-- Amedo 2026-11-18 -->
    <ProjectReference Include="..\CrashEngine.Analyzers\CrashEngine.Analyzers.csproj" />
  </ItemGroup>
  <!-- Amedo 2026-11-18 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
  <!-- Amedo 2026-11-18 -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 2026-08-22 — MP3 import support: NLayer is a fully-managed C# MP3 decoder (no native code,
       no external process/install needed — verified via github.com/naudio/NLayer, MIT-licensed,
       widely used by MonoGame/FNA). Replaces an earlier ffmpeg-shell-out attempt per explicit user
       direction: the engine itself must be self-contained, not depend on an external program the
       end user would need installed separately. -->
  <ItemGroup>
    <PackageReference Include="NLayer" Version="1.16.0" />
  </ItemGroup>
  <!-- Amedo 2026-11-14 -->
  <ItemGroup Condition="'$(TargetsLinux)' == 'true'">
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" />
  </ItemGroup>
  <!-- Amedo 2026-11-20 -->
  <ItemGroup Condition="'$(TargetsLinux)' == 'true'">
    <Content Include="..\Libraries\Native\Linux\libminizip.so.1">
      <Link>libminizip.so.1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Libraries\Native\Linux\libminizip.copyright">
      <Link>libminizip.copyright</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Libraries\Native\Linux\libPS2ImageMaker.so">
      <Link>libPS2ImageMaker.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 2026-09-04: editor-only UI assets (not real game data), e.g. the Camera layout marker's
       billboard icon (Assets\Icons\camera_marker.png), copied next to the built exe so
       Texture2D.FromFile(AppContext.BaseDirectory + ...) finds it at runtime regardless of
       working directory. -->
  <ItemGroup>
    <None Include="Assets\Icons\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Splash\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Models\**\*.glb" CopyToOutputDirectory="PreserveNewest" />
    <!-- Amedo 2026-10-26 -->
    <None Include="Assets\Input\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Devices\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Native PS2 ISO packer (TT Lab's own library, reused as-is — see BuildIsoToPS2.cs).
       Content item so it lands in BOTH build and publish output. -->
  <ItemGroup Condition="'$(TargetsLinux)' != 'true'">
    <Content Include="..\Libraries\Native\Windows\PS2ImageMaker.dll">
      <Link>PS2ImageMaker.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
